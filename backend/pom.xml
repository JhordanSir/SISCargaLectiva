<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml · qué necesita el backend para compilar y correr.
  - spring-boot-starter-web: servidor web (Tomcat) y los @RestController que responden JSON.
  - springdoc-openapi: la página /swagger-ui.html para probar los endpoints desde el navegador.
  - spring-boot-starter-test: JUnit y MockMvc para las pruebas de src/test.
  No hay base de datos: los datos son listas fijas en memoria (ver la carpeta repository).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>pe.edu.ulasalle</groupId>
  <artifactId>siscarga-api</artifactId>
  <version>1.0.0</version>
  <name>siscarga-api</name>
  <description>Servicios REST de SISCargaLectiva: parámetros del sistema y catálogos</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- El jar se llama siempre app.jar: así el Dockerfile no depende de la versión. -->
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
