# =============================================================
#  SISCargaLectiva · variables de entorno
# =============================================================
# Copia este archivo como .env y rellena los valores:
#
#     cp .env.example .env
#
# .env está excluido del control de versiones (.gitignore).
# Este archivo, .env.example, sí se versiona: no pongas valores
# reales en él, solo la documentación de cada variable.
#
# Las variables definidas en el entorno del sistema tienen
# prioridad sobre las de .env.


# -------------------------------------------------------------
#  Acceso con Google OAuth 2.0
# -------------------------------------------------------------

# ID de cliente OAuth del tipo «Aplicación web», creado en
# console.cloud.google.com → API y servicios → Credenciales.
# Termina en .apps.googleusercontent.com
#
# Es un dato público: viaja al navegador y no es un secreto.
# El SECRETO de cliente NO se pone aquí: el prototipo usa el modo
# de token de ID y no lo necesita. Cuando exista el backend con
# flujo de código de autorización, el secreto irá en una variable
# aparte y nunca debe llegar al navegador.
#
# Recuerda registrar el origen exacto desde el que sirves la
# aplicación en «Orígenes de JavaScript autorizados», por ejemplo
# http://localhost:8000 (debe coincidir carácter a carácter,
# puerto incluido).
GOOGLE_CLIENT_ID=

# Dominio institucional admitido para iniciar sesión.
# Las cuentas de otros dominios reciben acceso denegado.
SIS_DOMINIO=ulasalle.edu.pe


# -------------------------------------------------------------
#  Prototipo funcional (docs/prototipo/funcional)
# -------------------------------------------------------------

# Puerto en el que servir.py publica el prototipo. Con Docker Compose es
# el puerto del equipo; dentro del contenedor siempre escucha en el 8000.
# Si lo cambias, actualiza también el origen autorizado en Google Cloud.
SIS_PUERTO=8000

# Interfaz en la que escucha servir.py. Por defecto 127.0.0.1, es decir,
# solo el propio equipo. Docker Compose lo fuerza a 0.0.0.0 dentro del
# contenedor para que Traefik lo alcance; no hace falta definirlo aquí
# salvo que quieras exponerlo a la red a propósito.
# SIS_BIND=127.0.0.1


# -------------------------------------------------------------
#  Despliegue del prototipo (compose.yml)
# -------------------------------------------------------------
# Solo hacen falta en el servidor. En local el prototipo se arranca con
# «python3 servir.py» y no usa ninguna de estas.

# Dominio público por el que se sirve el prototipo. Debe estar además en
# «Orígenes de JavaScript autorizados» de Google Cloud, con https y sin
# barra final: https://nohagotuchamba.wayrasimi.tech
PROTOTIPO_HOST=nohagotuchamba.wayrasimi.tech

# Red de Docker en la que escucha Traefik. Compruébalo en el servidor con
# «docker network ls». En Dokploy suele ser dokploy-network; en una
# instalación propia de Traefik, a menudo «traefik» o «proxy».
TRAEFIK_NETWORK=dokploy-network

# Nombre del resolver de certificados configurado en tu Traefik. Aparece
# en su configuración estática, bajo certificatesResolvers.
TRAEFIK_CERTRESOLVER=letsencrypt


# -------------------------------------------------------------
#  Backend
# -------------------------------------------------------------
# Todavía no hay código de backend, así que aquí no se define
# ninguna variable. Cuando se cree el proyecto Spring Boot habrá
# que añadir al menos las de PostgreSQL, Flyway y el secreto de
# cliente de Google. No las inventes por adelantado: acuérdalas
# con el equipo y documéntalas aquí en el mismo commit en que se
# empiecen a usar.
